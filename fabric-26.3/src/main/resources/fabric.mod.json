{
  "schemaVersion": 1,
  "id": "aio",
  "version": "${version}",
  "name": "AIO Client",
  "description": "Modular PvP/QoL client: HUD, zoom, freecam, waypoints, item browser and 50+ more modules. Defers to other mods and has a server compatibility mode.",
  "authors": ["niniderpro"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.aio.fabric.AioFabricClient"]
  },
  "mixins": [
    {
      "config": "aio.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
